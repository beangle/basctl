<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified"
  version="1.0.0">

  <!--
    bas 配置（conf/server.xml）的格式定义，schema 版本 1.0.0。

    源文件：basctl/resources/bas-1.0.0.xsd
    发布副本：http://beangle.github.io/schema/bas-1.0.0.xsd
    解析实现：basctl/src/bas/config.d（parseServerXml）

    版本策略：schema 版本独立于 basctl / bas 的发行号。**发布后的文件冻结、不再改动**；
    遇到不兼容改动（元素或属性改名、删除、收紧约束）时新增 bas-<新版本>.xsd，
    旧文件原样保留——使用者配置里的 xsi:noNamespaceSchemaLocation 不必改动。
    仅新增可选元素 / 属性的兼容改动，可直接更新当前最新版本文件。

    约定：
    - 根元素为 <bas>；元素与属性一律小写连字符（kebab-case）。
    - 标注 anyAttribute 的元素会原样保留未声明属性（透传给 Tomcat 的
      Context/Loader/JarScanner），其余元素上的未声明项被忽略。
    - <proxy> / <resource-ref> / <realm> 均不在支持范围内：反代配置另行生成，JNDI 资源与
      Realm 尚未接入控制面。
  -->

  <!-- ================= 基础类型 ================= -->

  <xs:simpleType name="boolType">
    <xs:annotation>
      <xs:documentation>布尔字面量，仅接受 true / false</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="farmNameType">
    <xs:annotation>
      <xs:documentation>farm 名；不能包含点（点用于 `farm.server` 限定名）</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[^.]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ================= 根 ================= -->

  <xs:element name="bas">
    <xs:annotation>
      <xs:documentation>配置根；各段顺序不限、各自至多一次（repository 与 snapshot-repo 可同时出现）。</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element name="repository" type="repositoryType" minOccurs="0"/>
        <xs:element name="snapshot-repo" type="repositoryType" minOccurs="0"/>
        <xs:element name="engines" type="enginesType" minOccurs="0"/>
        <xs:element name="hosts" type="hostsType" minOccurs="0"/>
        <xs:element name="resources" type="resourcesType" minOccurs="0"/>
        <xs:element name="farms" type="farmsType" minOccurs="0"/>
        <xs:element name="webapps" type="webappsType" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="version" type="xs:string" use="required">
        <xs:annotation>
          <xs:documentation>beangle-bas-engine（及 beangle-bas-juli）版本；basctl 据此解析引擎构件。
            容器版本在 &lt;engine version&gt; 上声明，二者互相独立。</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- ================= 仓库 ================= -->

  <xs:complexType name="repositoryType">
    <xs:annotation>
      <xs:documentation>release / SNAPSHOT 仓库；remote 与 token 支持 ${bas_remote_url}、${bas_remote_token} 占位。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="local" type="xs:string">
      <xs:annotation>
        <xs:documentation>本地仓库目录；缺省由 jstart 决定。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="remote" type="xs:string">
      <xs:annotation>
        <xs:documentation>上游地址，逗号分隔；缺省交给 jstart 内置默认（仅 release）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="token" type="xs:string">
      <xs:annotation>
        <xs:documentation>受保护仓库的读令牌。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ================= 引擎 ================= -->

  <xs:complexType name="enginesType">
    <xs:sequence>
      <xs:element name="engine" type="engineType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="engineType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="listener" type="listenerType"/>
      <xs:element name="context" type="contextType"/>
      <xs:element name="jar" type="jarType"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>容器的运行形态，与 basctl 的 creator 同名：
          tomcat-server（全量 Tomcat 发行包，多应用）/ tomcat / undertow / jetty（嵌入式单应用）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="version" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>容器版本：tomcat 为发行包版本，undertow 为 io.undertow.ee:undertow-servlet 版本，
          jetty 为 org.eclipse.jetty.ee10:jetty-ee10-webapp 版本。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="jsp-support" type="boolType">
      <xs:annotation>
        <xs:documentation>仅 tomcat-server 生效（缺省 false）：开启时保留 jasper 并在
          conf/web.xml 注册 JSP servlet；关闭时精简掉 jasper/ecj。嵌入式引擎固定屏蔽
          Jasper SCI，本属性对它们无效果。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="websocket-support" type="boolType">
      <xs:annotation>
        <xs:documentation>是否引入 WebSocket 构件（缺省 true）。false 时 basctl 跳过
          engines.ini 中 &lt;type&gt;.websocket 分节，不再下载 tomcat-embed-websocket /
          undertow-websockets / jetty websocket 等依赖。tomcat-server 的 WebSocket 随
          发行包提供，本属性对它无效果。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="listenerType">
    <xs:annotation>
      <xs:documentation>Server 级 Listener；class-name 之外的同级属性原样透传。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="class-name" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="contextType">
    <xs:all>
      <xs:element name="loader" type="loaderType" minOccurs="0"/>
      <xs:element name="jar-scanner" type="jarScannerType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="loaderType">
    <xs:annotation>
      <xs:documentation>Context 的 Loader；class-name 之外的同级属性原样透传。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="class-name" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="jarScannerType">
    <xs:annotation>
      <xs:documentation>Context 的 JarScanner；属性全部原样透传。</xs:documentation>
    </xs:annotation>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="jarType">
    <xs:annotation>
      <xs:documentation>引擎 jar；uri 为 gav:// / http(s):// 或本地路径。与 engines.ini 的
        默认集合并：GA（groupId:artifactId）相同则覆盖，否则追加（可加自定义依赖）。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="uri" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ================= 主机 ================= -->

  <xs:complexType name="hostsType">
    <xs:sequence>
      <xs:element name="host" type="hostType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="hostType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="ip" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ================= 资源 ================= -->

  <xs:complexType name="resourcesType">
    <xs:sequence>
      <xs:element name="resource" type="resourceType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="resourceType">
    <xs:annotation>
      <xs:documentation>JNDI 资源；name 之外的属性原样透传给 Tomcat（如 url/type/username/password/driverClassName）。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- ================= 实例组 ================= -->

  <xs:complexType name="farmsType">
    <xs:sequence>
      <xs:element name="farm" type="farmType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="farmType">
    <xs:annotation>
      <xs:documentation>子元素顺序不限；server 可重复，其余各至多一次。</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="server-options" type="xs:string">
        <xs:annotation>
          <xs:documentation>追加到 JVM 参数的进程参数（整段文本，按行拼接）。</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="proxy-options" type="xs:string">
        <xs:annotation>
          <xs:documentation>反代片段；basctl 不消费。</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="http" type="httpType"/>
      <xs:element name="server" type="serverType"/>
    </xs:choice>
    <xs:attribute name="name" type="farmNameType" use="required"/>
    <xs:attribute name="engine" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>引用的 &lt;engine name&gt;，必须已声明。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-heap-size" type="xs:string">
      <xs:annotation>
        <xs:documentation>JVM 堆上限，如 300M / 1G；缺省 300M。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="httpType">
    <xs:annotation>
      <xs:documentation>HTTP Connector 参数，按项转成容器的 connector 调优：嵌入式的 tomcat/undertow/jetty
读 --Dconnector.*，tomcat-server 渲染进 conf/server.xml 的 Connector。Tomcat 全部生效；Jetty 只用
accept-count/connection-timeout；Undertow 只用 accept-count/connection-timeout，max-connections 忽略。
未显式给出的项取 basctl 缺省（connection-timeout 缺省 60000，accept-count/max-connections 不下发）。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="enable-lookups" type="boolType"/>
    <xs:attribute name="accept-count" type="xs:nonNegativeInteger"/>
    <xs:attribute name="max-connections" type="xs:nonNegativeInteger"/>
    <xs:attribute name="disable-upload-timeout" type="boolType"/>
    <xs:attribute name="connection-timeout" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>毫秒；缺省 60000。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="serverType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="http" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>JVM 内的 http 端口；缺省 0。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="host" type="xs:string">
      <xs:annotation>
        <xs:documentation>引用的 &lt;host name&gt;；缺省 localhost。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-heap-size" type="xs:string">
      <xs:annotation>
        <xs:documentation>缺省继承所属 farm。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="proxy-http-port" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>由 bashub 生成；basctl 不消费。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="proxy-options" type="xs:string">
      <xs:annotation>
        <xs:documentation>由 bashub 生成；basctl 不消费。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ================= 应用 ================= -->

  <xs:complexType name="webappsType">
    <xs:sequence>
      <xs:element name="webapp" type="webappType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="webappType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="url" type="urlType"/>
    </xs:choice>
    <xs:attribute name="uri" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>gav:// / http(s):// 或本地路径。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="path" type="xs:string">
      <xs:annotation>
        <xs:documentation>context path；/ 或空视为 ROOT。仅描述部署上下文，路由用的对外路径见 &lt;url&gt;。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="run-at" type="xs:string">
      <xs:annotation>
        <xs:documentation>部署目标，逗号分隔的 farm 名或 `farm.server` 限定名。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="doc-base" type="xs:string">
      <xs:annotation>
        <xs:documentation>直接指定目录/war；缺省由 uri 推导。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="libs" type="xs:string">
      <xs:annotation>
        <xs:documentation>追加依赖，逗号分隔的 gav。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="jsp-support" type="boolType"/>
    <xs:attribute name="resolve-support" type="boolType">
      <xs:annotation>
        <xs:documentation>是否解析 war 内依赖；缺省 true，仅字面 false 关闭。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unpack" type="boolType"/>
    <xs:anyAttribute processContents="lax">
      <xs:annotation>
        <xs:documentation>其余属性原样透传给 Tomcat Context（如 reloadable）。</xs:documentation>
      </xs:annotation>
    </xs:anyAttribute>
  </xs:complexType>

  <xs:complexType name="urlType">
    <xs:annotation>
      <xs:documentation>webapp 对外暴露的 URL 前缀，供 setline / 反代按路径转发。可声明多条；
        都未声明时按 &lt;webapp path&gt; 的 context path 转发。上下文为 / 而内部 URL 无公共前缀时
        （如 /context1、/context2），必须逐条列出，否则多个这样的 webapp 会争用同一路径。</xs:documentation>
    </xs:annotation>
    <xs:attribute name="path" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>以 / 开头的 URL 前缀；交由 basctl 规范化（去掉尾部 /）。</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

</xs:schema>
