// Allow the basagent user to start only the two fixed proxy-apply units.
// JavaScript rules are supported by polkit >= 0.106, including CentOS 7's 0.112.
polkit.addRule(function(action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units")
    return;

  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (subject.user === "bas" && verb === "start" &&
      (unit === "basproxy-apply@haproxy.service" ||
       unit === "basproxy-apply@nginx.service"))
    return polkit.Result.YES;
});
