# Installed by basctl: allow basagent to start micdn and only the fixed proxy-apply units.
# CentOS 7's systemd 219 does not pass unit details to polkit, so polkit cannot
# safely restrict the target unit there.
Defaults:bas !requiretty
Cmnd_Alias BASPROXY_APPLY = /usr/bin/systemctl start basproxy-apply@haproxy.service, /usr/bin/systemctl start basproxy-apply@nginx.service
Cmnd_Alias MICDN_START = /usr/bin/systemctl start micdn.service
bas ALL=(root) NOPASSWD: BASPROXY_APPLY, MICDN_START
