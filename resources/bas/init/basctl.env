# basctl.env - 与 bashub 控制台连接的配置。
#
# 安装位置：/etc/bas/conf/basctl.env，属主 root:beangle、权限 0640。
# systemd 用 EnvironmentFile 注入；手工执行 bin/*.sh 时由 env.sh source
# （源码/自定义目录用 BAS_ENV_FILE 指向本文件）。
# 仅在本机独立使用时，保持下面两项为空即可；start.sh / restart.sh 只读本地配置。
# 接入 bashub 后本文件包含凭证；basctl init 不会创建或修改它。

# project@url，例如 openurp.prod@https://hub.example.com
BAS_PRINCIPAL=
# Project 的 key（bashub 配置详情里可查看/重置）
BAS_TOKEN=
