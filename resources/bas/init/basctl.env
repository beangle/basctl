# basctl.env - 与 bashub 控制台连接的配置。
#
# 本文件由 systemd 作为 EnvironmentFile 注入；也可在手工运行时 source。
# 仅在本机独立使用时，保持下面两项为空即可；start.sh / restart.sh 只读本地配置。
# 接入 bashub 后本文件包含凭证，basctl init 已按 0600 创建，请勿放宽权限。

# project@url，例如 openurp.prod@https://hub.example.com
BAS_PRINCIPAL=
# Project 的 key（bashub 配置详情里可查看/重置）
BAS_TOKEN=
