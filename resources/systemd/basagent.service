[Unit]
Description=Beangle basagent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/bas/conf/server.xml

[Service]
Type=simple
User=bas
Group=beangle
Environment=HOME=/var/lib/bas
Environment=BAS_HOME=/var/lib/bas
EnvironmentFile=-/etc/sysconfig/basagent
EnvironmentFile=-/etc/default/basagent
WorkingDirectory=/var/lib/bas
ExecStartPre=/bin/mkdir -p /var/log/bas/agent
ExecStart=/bin/sh -c 'exec /usr/bin/basagent /var/lib/bas/conf/server.xml >>/var/log/bas/agent/console.out 2>&1'
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
# 控制台（service:start）拉起的实例继承本单元的 cgroup；升级/重启 agent 时只结束
# agent 自己，别把正在运行的应用一起 SIGTERM（实例的生命周期归 basctl / server.info）。
KillMode=process
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
