<?xml version='1.0' encoding='utf-8'?>
<bas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://beangle.github.io/schema/bas-1.0.0.xsd"
     version="0.14.0">
  <engines>
    <engine name="tomcat" type="tomcat-server" version="11.0.26">
      <jar uri="gav://org.postgresql:postgresql:42.7.9"/>
    </engine>
  </engines>

  <farms>
    <farm name="tools" engine="tomcat">
      <server name="server1" http="8088"/>
    </farm>
    <farm name="platform" engine="tomcat">
      <server-options>-Dems.profile=local</server-options>
      <server name="server1" http="8081"/>
    </farm>
  </farms>

  <webapps>
    <webapp name="tools" uri="gav://org.beangle.otk:beangle-otk-ws:0.0.21" run-at="tools" path="/api/tools" />
    <webapp  uri="gav://org.beangle.ems:beangle-ems-cas:4.17.2" run-at="platform" path="/cas" />
    <webapp  uri="gav://org.beangle.ems:beangle-ems-portal:4.17.2" run-at="platform" path="/portal" />
    <webapp  uri="gav://org.beangle.ems:beangle-ems-ws:4.17.2" run-at="platform" path="/api/platform" />
  </webapps>

  <!--
    <setline> 出现即启用路由对账：basctl 起停实例时把运行中实例的路由推给本机的 setline。
      hostname  路由命名空间（缺省 localhost，* 表示任意 Host）——共享同一个 setline 的多份
                BAS_HOME 各占一格。
      port      本 BAS_HOME 要推路由的 setline 管理口（adminListen）**端口**。写接口只在管理口
                上、且只认回环来的连接，所以 basctl 拨的就是 127.0.0.1:port，地址没有可配的余地。
                必填，没有缺省：端口是这台机器上的事实，写在这里比藏在别处看得见。
                setline 自己的配置（listen / adminListen）不归 basctl 生成。
  -->
  <setline hostname="localhost" port="10080"/>
</bas>
