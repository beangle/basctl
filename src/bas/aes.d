private immutable ubyte[10] rcon = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36];

/**
 * AES 加解密器：密钥取 `SHA-1(secret)` 前 16 字节，ECB 模式，PKCS#5 填充。
 */
class Aes {
  private ubyte[16] key;

  /** 由口令派生密钥：`SHA-1(secret)` 的前 16 字节（与 Java `Cipher` 侧一致）。 */
  this(string secretKey) {
    auto digest = sha1Of(cast(ubyte[]) secretKey);
    key[] = digest[0 .. 16];
  }

  /** 加密明文，返回小写十六进制。 */
  string encrypt(string plain) {
    auto data = cast(ubyte[]) plain.dup;
    auto pad = cast(ubyte)(16 - (data.length % 16));
    foreach (_; 0 .. pad)
      data ~= pad;

    string hex;
    foreach (offset; 0 .. data.length / 16) {
      ubyte[16] block;
      block[] = data[offset * 16 .. offset * 16 + 16];
      foreach (b; aesEncryptBlock(key, block))
        hex ~= format!"%02x"(b);
    }
    return hex;
  }

  /** 解密十六进制串，返回去掉 PKCS#5 填充后的明文。 */
  string decrypt(string encoded) {
    auto data = hexToBytes(encoded);
    if (data.length == 0 || data.length % 16 != 0)
      throw new Exception("Invalid AES cipher text");

    ubyte[] plain;
    foreach (offset; 0 .. data.length / 16) {
      ubyte[16] block;
      block[] = data[offset * 16 .. offset * 16 + 16];
      plain ~= aesDecryptBlock(key, block)[];
    }
    auto pad = plain[$ - 1];
    if (pad < 1 || pad > 16 || pad > plain.length)
      throw new Exception("Invalid AES padding");
    return cast(string) plain[0 .. $ - pad].idup;
  }
}

/** 单块 AES-128 加密（FIPS-197 语义，用于验证）. */
ubyte[16] aesEncryptBlock(const ubyte[16] key, const ubyte[16] input) {
  auto roundKeys = expandKey(key);
  ubyte[16] state = input;
  addRoundKey(state, roundKeys, 0);
  foreach (round; 1 .. 10) {
    subBytes(state);
    shiftRows(state);
    mixColumns(state);
    addRoundKey(state, roundKeys, round);
  }
  subBytes(state);
  shiftRows(state);
  addRoundKey(state, roundKeys, 10);
  return state;
}

/** 单块 AES-128 解密. */
ubyte[16] aesDecryptBlock(const ubyte[16] key, const ubyte[16] input) {
  auto roundKeys = expandKey(key);
  ubyte[16] state = input;
  addRoundKey(state, roundKeys, 10);
  for (auto round = 9; round >= 1; --round) {
    invShiftRows(state);
    invSubBytes(state);
    addRoundKey(state, roundKeys, round);
    invMixColumns(state);
  }
  invShiftRows(state);
  invSubBytes(state);
  addRoundKey(state, roundKeys, 0);
  return state;
}

/** 密钥扩展：16 字节密钥展开为 11 组轮密钥（AES-128，共 176 字节）。 */
private ubyte[176] expandKey(const ubyte[16] key) {
  ubyte[176] w;
  w[0 .. 16] = key[];
  auto i = 16;
  auto rconIndex = 0;
  while (i < 176) {
    ubyte[4] t = [w[i - 4], w[i - 3], w[i - 2], w[i - 1]];
    if (i % 16 == 0) {
      auto first = t[0];
      t[0] = cast(ubyte)(sbox[t[1]] ^ rcon[rconIndex]);
      t[1] = sbox[t[2]];
      t[2] = sbox[t[3]];
      t[3] = sbox[first];
      ++rconIndex;
    }
    foreach (j; 0 .. 4) {
      w[i] = cast(ubyte)(w[i - 16] ^ t[j]);
      ++i;
    }
  }
  return w;
}

/** 轮密钥加（AddRoundKey）：与第 `round` 组轮密钥按字节异或。 */
private void addRoundKey(ref ubyte[16] state, const ubyte[176] roundKeys, int round) {
  foreach (i; 0 .. 16)
    state[i] ^= roundKeys[round * 16 + i];
}

/** 字节代换（SubBytes）：逐字节查 S 盒。 */
private void subBytes(ref ubyte[16] state) {
  foreach (ref b; state)
    b = sbox[b];
}

/** 逆字节代换（InvSubBytes）：逐字节查逆 S 盒。 */
private void invSubBytes(ref ubyte[16] state) {
  foreach (ref b; state)
    b = invSbox[b];
}

/** 行移位（ShiftRows）：按行左移 0/1/2/3 字节（状态按列优先展平）。 */
private void shiftRows(ref ubyte[16] s) {
  ubyte[16] t = s;
  s[1] = t[5];
  s[5] = t[9];
  s[9] = t[13];
  s[13] = t[1];
  s[2] = t[10];
  s[6] = t[14];
  s[10] = t[2];
  s[14] = t[6];
  s[3] = t[15];
  s[7] = t[3];
  s[11] = t[7];
  s[15] = t[11];
}

/** 逆行移位（InvShiftRows）：`shiftRows` 的逆操作。 */
private void invShiftRows(ref ubyte[16] s) {
  ubyte[16] t = s;
  s[1] = t[13];
  s[5] = t[1];
  s[9] = t[5];
  s[13] = t[9];
  s[2] = t[10];
  s[6] = t[14];
  s[10] = t[2];
  s[14] = t[6];
  s[3] = t[7];
  s[7] = t[11];
  s[11] = t[15];
  s[15] = t[3];
}

/** 列混合（MixColumns）：在 GF(2^8) 上对每列做固定矩阵乘法。 */
private void mixColumns(ref ubyte[16] s) {
  foreach (c; 0 .. 4) {
    auto i = 4 * c;
    auto a0 = s[i];
    auto a1 = s[i + 1];
    auto a2 = s[i + 2];
    auto a3 = s[i + 3];
    s[i] = cast(ubyte)(mul(a0, 2) ^ mul(a1, 3) ^ a2 ^ a3);
    s[i + 1] = cast(ubyte)(a0 ^ mul(a1, 2) ^ mul(a2, 3) ^ a3);
    s[i + 2] = cast(ubyte)(a0 ^ a1 ^ mul(a2, 2) ^ mul(a3, 3));
    s[i + 3] = cast(ubyte)(mul(a0, 3) ^ a1 ^ a2 ^ mul(a3, 2));
  }
}

/** 逆列混合（InvMixColumns）：`mixColumns` 的逆操作。 */
private void invMixColumns(ref ubyte[16] s) {
  foreach (c; 0 .. 4) {
    auto i = 4 * c;
    auto a0 = s[i];
    auto a1 = s[i + 1];
    auto a2 = s[i + 2];
    auto a3 = s[i + 3];
    s[i] = cast(ubyte)(mul(a0, 14) ^ mul(a1, 11) ^ mul(a2, 13) ^ mul(a3, 9));
    s[i + 1] = cast(ubyte)(mul(a0, 9) ^ mul(a1, 14) ^ mul(a2, 11) ^ mul(a3, 13));
    s[i + 2] = cast(ubyte)(mul(a0, 13) ^ mul(a1, 9) ^ mul(a2, 14) ^ mul(a3, 11));
    s[i + 3] = cast(ubyte)(mul(a0, 11) ^ mul(a1, 13) ^ mul(a2, 9) ^ mul(a3, 14));
  }
}

/** GF(2^8)（模 0x11b）上的乘法，用于列混合。 */
private ubyte mul(ubyte a, ubyte b) {
  ubyte result;
  foreach (_; 0 .. 8) {
    if (b & 1)
      result ^= a;
    auto high = a & 0x80;
    a <<= 1;
    if (high)
      a ^= 0x1b;
    b >>= 1;
  }
  return result;
}

/** 十六进制（小写或大写）转字节；长度为奇数时抛异常。 */
private ubyte[] hexToBytes(string hex) {
  if (hex.length % 2 != 0)
    throw new Exception("Invalid hex string length");
  ubyte[] res;
  res.length = hex.length / 2;
  foreach (i; 0 .. res.length) {
    import std.conv : to;

    res[i] = to!ubyte(hex[i * 2 .. i * 2 + 2], 16);
  }
  return res;
}

@("FIPS-197 AES-128 block vector") unittest {
  ubyte[16] key = [
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f
  ];
  ubyte[16] plain = [
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff
  ];
  ubyte[16] expected = [
    0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30, 0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a
  ];
  assert(aesEncryptBlock(key, plain) == expected);
  assert(aesDecryptBlock(key, expected) == plain);
}

@("aes round trip with padding") unittest {
  auto aes = new Aes("secret");
  foreach (text; ["", "a", "hello world", "0123456789abcdef", "中文测试文本"])
    assert(aes.decrypt(aes.encrypt(text)) == text);
}

@("aes matches java AES/ECB/PKCS5Padding (openssl verified)") unittest {
  // key = SHA1("secret")[0..16] = e5e9fa1ba31ecd1ae84f75caaa474f3a
  assert(new Aes("secret").encrypt("hello world") == "b71ee13b96bf01c174cf0dba4504900f");
}
